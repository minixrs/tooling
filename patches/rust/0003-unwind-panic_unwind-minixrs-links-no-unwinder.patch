From 93f45c3f7914f839acb336225ee3be8c5bd50e32 Mon Sep 17 00:00:00 2001
From: Kevin Barnard <kevin.barnard@gmail.com>
Date: Fri, 2 Oct 2026 23:21:22 -0500
Subject: [PATCH 3/7] unwind, panic_unwind: minixrs links no unwinder

minixrs is panic=abort until LLVM libunwind is built for it. The
panic_unwind crate takes its dummy runtime and std no gcc personality,
as for espidf and nuttx. backtrace-rs still links the stack-walker entry
points on every Unix target, so the unwind crate gives minixrs a null
unwinder: _Unwind_Backtrace reports the end of the stack before the
first frame, and std calls the resulting empty trace unsupported.

Signed-off-by: Kevin Barnard <kevin.barnard@gmail.com>
---
 library/panic_unwind/src/lib.rs        |  5 +++-
 library/std/src/sys/personality/mod.rs |  7 +++++-
 library/unwind/src/lib.rs              |  5 ++++
 library/unwind/src/minixrs.rs          | 32 ++++++++++++++++++++++++++
 4 files changed, 47 insertions(+), 2 deletions(-)
 create mode 100644 library/unwind/src/minixrs.rs

diff --git a/library/panic_unwind/src/lib.rs b/library/panic_unwind/src/lib.rs
index d25d94258a1..94d04f76a20 100644
--- a/library/panic_unwind/src/lib.rs
+++ b/library/panic_unwind/src/lib.rs
@@ -37,7 +37,10 @@
         target_os = "psp",
         target_os = "xous",
         target_os = "solid_asp3",
-        all(target_family = "unix", not(any(target_os = "espidf", target_os = "nuttx"))),
+        all(
+            target_family = "unix",
+            not(any(target_os = "espidf", target_os = "nuttx", target_os = "minixrs"))
+        ),
         all(target_vendor = "fortanix", target_env = "sgx"),
         target_family = "wasm",
     ) => {
diff --git a/library/std/src/sys/personality/mod.rs b/library/std/src/sys/personality/mod.rs
index 31bd457adbe..30bb24dab06 100644
--- a/library/std/src/sys/personality/mod.rs
+++ b/library/std/src/sys/personality/mod.rs
@@ -30,7 +30,12 @@ fn rust_eh_personality() {
         target_os = "psp",
         target_os = "xous",
         target_os = "solid_asp3",
-        all(target_family = "unix", not(target_os = "espidf"), not(target_os = "nuttx")),
+        all(
+            target_family = "unix",
+            not(target_os = "espidf"),
+            not(target_os = "nuttx"),
+            not(target_os = "minixrs")
+        ),
         all(target_vendor = "fortanix", target_env = "sgx"),
     ) => {
         mod gcc;
diff --git a/library/unwind/src/lib.rs b/library/unwind/src/lib.rs
index fb0acdab835..b02c89557cb 100644
--- a/library/unwind/src/lib.rs
+++ b/library/unwind/src/lib.rs
@@ -21,6 +21,11 @@
     any(target_os = "none", target_os = "espidf", target_os = "nuttx") => {
         // These "unix" family members do not have unwinder.
     }
+    target_os = "minixrs" => {
+        // No unwinder yet: panic = "abort" only. backtrace-rs still links the
+        // walker entry points, so this answers them with an empty stack.
+        mod minixrs;
+    }
     any(
         unix,
         windows,
diff --git a/library/unwind/src/minixrs.rs b/library/unwind/src/minixrs.rs
new file mode 100644
index 00000000000..88153126e65
--- /dev/null
+++ b/library/unwind/src/minixrs.rs
@@ -0,0 +1,32 @@
+//! A null unwinder for minixrs, which links no unwinder yet (`panic = "abort"`).
+//!
+//! backtrace-rs, which std compiles in for every Unix target, calls
+//! `_Unwind_Backtrace` to walk the stack. Answering `_URC_END_OF_STACK` before
+//! the first frame leaves every trace empty, which std reports as
+//! `BacktraceStatus::Unsupported`. No context is ever handed out, so the
+//! accessors below are never reached; they exist only so that the link
+//! resolves. Delete this module when LLVM libunwind is linked for minixrs.
+
+use core::ffi::c_void;
+
+const URC_END_OF_STACK: i32 = 5;
+
+#[unsafe(no_mangle)]
+pub extern "C" fn _Unwind_Backtrace(_trace: *mut c_void, _arg: *mut c_void) -> i32 {
+    URC_END_OF_STACK
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn _Unwind_GetIP(_ctx: *mut c_void) -> usize {
+    0
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn _Unwind_GetCFA(_ctx: *mut c_void) -> usize {
+    0
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn _Unwind_FindEnclosingFunction(_pc: *mut c_void) -> *mut c_void {
+    core::ptr::null_mut()
+}
