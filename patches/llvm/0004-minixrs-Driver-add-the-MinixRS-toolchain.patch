+#ifndef LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_MINIXRS_H
+#define LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_MINIXRS_H
+
+#include "clang/Driver/Tool.h"
+#include "clang/Driver/ToolChain.h"
+
+namespace clang {
+namespace driver {
+namespace tools {
+namespace minixrs {
+class LLVM_LIBRARY_VISIBILITY Linker final : public Tool {
+public:
+  Linker(const ToolChain &TC) : Tool("minixrs::Linker", "ld.lld", TC) {}
+
+  bool hasIntegratedCPP() const override { return false; }
+  bool isLinkJob() const override { return true; }
+
+  void ConstructJob(Compilation &C, const JobAction &JA,
+                    const InputInfo &Output, const InputInfoList &Inputs,
+                    const llvm::opt::ArgList &TCArgs,
+                    const char *LinkingOutput) const override;
+};
+} // end namespace minixrs
+} // end namespace tools
+
+namespace toolchains {
+
+/// minixrs — a static-only ELF platform served by an SDK laid out per the
+/// tooling repo's docs/sysroot-layout.md: clang and ld.lld in
+/// $MINIXRS_SDK/bin, headers and libraries under $MINIXRS_SDK/sysroot/usr.
+/// There are no shared objects, no dynamic linker, and no sanitizer runtimes.
+class LLVM_LIBRARY_VISIBILITY MinixRS : public ToolChain {
+public:
+  MinixRS(const Driver &D, const llvm::Triple &Triple,
+          const llvm::opt::ArgList &Args);
+
+  bool HasNativeLLVMSupport() const override { return true; }
+
+  // Static, non-PIE executables only.
+  bool isPICDefault() const override { return false; }
+  bool isPIEDefault(const llvm::opt::ArgList &Args) const override {
+    return false;
+  }
+  bool isPICDefaultForced() const override { return false; }
+
+  RuntimeLibType GetDefaultRuntimeLibType() const override {
+    return ToolChain::RLT_CompilerRT;
+  }
+  // libc++ or nothing — libstdc++ is never an option here. No libc++ is built
+  // for minixrs yet, so there is deliberately no AddClangCXXStdlibIncludeArgs
+  // override: it would have nothing to point at. Add one (Fuchsia.cpp is the
+  // crib) when a C++ standard library lands in the sysroot.
+  CXXStdlibType GetDefaultCXXStdlibType() const override {
+    return ToolChain::CST_Libcxx;
+  }
+  RuntimeLibType
+  GetRuntimeLibType(const llvm::opt::ArgList &Args) const override;
+  CXXStdlibType GetCXXStdlibType(const llvm::opt::ArgList &Args) const override;
+
+  // No sanitizer runtimes are built for this target.
+  SanitizerMask getSupportedSanitizers() const override {
+    return SanitizerMask();
+  }
+
+  void
+  AddClangSystemIncludeArgs(const llvm::opt::ArgList &DriverArgs,
+                            llvm::opt::ArgStringList &CC1Args) const override;
+
+  const char *getDefaultLinker() const override { return "ld.lld"; }
+
+  /// --sysroot if given, otherwise $MINIXRS_SDK/sysroot derived from the
+  /// driver's own location.
+  std::string computeSysRoot() const override;
+
+protected:
+  Tool *buildLinker() const override;
+};
+
+} // end namespace toolchains
+} // end namespace driver
+} // end namespace clang
+
+#endif // LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_MINIXRS_H
