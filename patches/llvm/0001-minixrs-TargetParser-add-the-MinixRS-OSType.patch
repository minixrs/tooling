From 2963205c993d136e646f50d4190d27f039216c1c Mon Sep 17 00:00:00 2001
From: Kevin Barnard <kevin.barnard@gmail.com>
Date: Sun, 26 Jul 2026 01:16:05 -0500
Subject: [PATCH 1/5] [minixrs] TargetParser: add the MinixRS OSType

Teach Triple about `aarch64-unknown-minixrs`, the first of the M2 series.

Appended after CheriotRTOS rather than inserted alphabetically: OSType
values are ordinals, and renumbering the existing OSes would be a
gratuitous churn point for a rebase-maintained fork.

parseOS matches by prefix. Nothing currently in the switch is a prefix of
"minixrs" -- upstream deleted Minix in 24eaf7858b46, an ancestor of
llvmorg-22.1.8 -- but a rebase that reintroduces a "minix" arm must order
it after this one, so the comment records the hazard in the forward
direction.
---
 llvm/include/llvm/TargetParser/Triple.h | 5 ++++-
 llvm/lib/TargetParser/Triple.cpp        | 7 +++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/llvm/include/llvm/TargetParser/Triple.h b/llvm/include/llvm/TargetParser/Triple.h
index 9c83abeeb3b1..126861dbf305 100644
--- a/llvm/include/llvm/TargetParser/Triple.h
+++ b/llvm/include/llvm/TargetParser/Triple.h
@@ -252,7 +252,8 @@ public:
     Serenity,
     Vulkan, // Vulkan SPIR-V
     CheriotRTOS,
-    LastOSType = CheriotRTOS
+    MinixRS, // minixrs
+    LastOSType = MinixRS
   };
   enum EnvironmentType {
     UnknownEnvironment,
@@ -786,6 +787,8 @@ public:
     return getOS() == Triple::Serenity;
   }
 
+  bool isOSMinixRS() const { return getOS() == Triple::MinixRS; }
+
   /// Tests whether the OS uses the ELF binary format.
   bool isOSBinFormatELF() const {
     return getObjectFormat() == Triple::ELF;
diff --git a/llvm/lib/TargetParser/Triple.cpp b/llvm/lib/TargetParser/Triple.cpp
index a4f9dd42c0fe..a132af9f5a45 100644
--- a/llvm/lib/TargetParser/Triple.cpp
+++ b/llvm/lib/TargetParser/Triple.cpp
@@ -341,6 +341,8 @@ StringRef Triple::getOSTypeName(OSType Kind) {
   case Vulkan: return "vulkan";
   case CheriotRTOS:
     return "cheriotrtos";
+  case MinixRS:
+    return "minixrs";
   }
 
   llvm_unreachable("Invalid OSType");
@@ -754,6 +756,11 @@ static Triple::OSType parseOS(StringRef OSName) {
       .StartsWith("serenity", Triple::Serenity)
       .StartsWith("vulkan", Triple::Vulkan)
       .StartsWith("cheriotrtos", Triple::CheriotRTOS)
+      // Matching is by prefix: nothing above is a prefix of "minixrs". If a
+      // future rebase reintroduces a "minix" arm (deleted upstream in
+      // 24eaf7858b46), it must be ordered *after* this one, or "minix" would
+      // shadow the longer name.
+      .StartsWith("minixrs", Triple::MinixRS)
       .Default(Triple::UnknownOS);
 }
 
