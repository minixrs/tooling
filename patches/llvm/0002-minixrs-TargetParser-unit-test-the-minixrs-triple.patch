From 9018ff2ecf44c424a1d2e449fae770a308d4d981 Mon Sep 17 00:00:00 2001
From: Kevin Barnard <kevin.barnard@gmail.com>
Date: Sun, 26 Jul 2026 01:16:06 -0500
Subject: [PATCH 2/5] [minixrs] TargetParser: unit-test the minixrs triple

Covers parse (arch/vendor/os/environment), the getOSTypeName round-trip,
and that the normalized string survives, in TripleTest.ParsedIDs beside
the existing fuchsia block.

No "plain minix still parses as Triple::Minix" regression assert: that
enumerator does not exist at llvmorg-22.1.8, so the assert would not
compile.
---
 llvm/unittests/TargetParser/TripleTest.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/llvm/unittests/TargetParser/TripleTest.cpp b/llvm/unittests/TargetParser/TripleTest.cpp
index b2e498ee10b3..bb562e74963d 100644
--- a/llvm/unittests/TargetParser/TripleTest.cpp
+++ b/llvm/unittests/TargetParser/TripleTest.cpp
@@ -589,6 +589,14 @@ TEST(TripleTest, ParsedIDs) {
   EXPECT_EQ(Triple::Fuchsia, T.getOS());
   EXPECT_EQ(Triple::UnknownEnvironment, T.getEnvironment());
 
+  T = Triple("aarch64-unknown-minixrs");
+  EXPECT_EQ(Triple::aarch64, T.getArch());
+  EXPECT_EQ(Triple::UnknownVendor, T.getVendor());
+  EXPECT_EQ(Triple::MinixRS, T.getOS());
+  EXPECT_EQ(Triple::UnknownEnvironment, T.getEnvironment());
+  EXPECT_EQ("minixrs", Triple::getOSTypeName(Triple::MinixRS));
+  EXPECT_EQ("aarch64-unknown-minixrs", Triple::normalize("aarch64-unknown-minixrs"));
+
   T = Triple("x86_64-unknown-hermit");
   EXPECT_EQ(Triple::x86_64, T.getArch());
   EXPECT_EQ(Triple::UnknownVendor, T.getVendor());
