+++ b/clang/test/Driver/minixrs.c
@@ -0,0 +1,90 @@
+// The minixrs driver: static-only ELF, ld.lld, sysroot under <sysroot>/usr.
+// The behaviour pinned here is the tooling repo's docs/sysroot-layout.md
+// contract, which tooling/verify/check-driver.sh gates at the SDK level.
+
+// The negatives are --implicit-check-not rather than inline CHECK-NOT lines:
+// an inline CHECK-NOT only scans the gap between the two positive matches that
+// surround it, which here would be the few tokens between the second -z pair
+// and crt1.o. --implicit-check-not applies to every gap, including the tail
+// after the last match.
+// RUN: %clang -### %s --target=aarch64-unknown-minixrs \
+// RUN:     -resource-dir=%S/Inputs/minixrs_tree/resource_dir \
+// RUN:     --sysroot=%S/Inputs/minixrs_tree/sysroot 2>&1 \
+// RUN:     | FileCheck %s --implicit-check-not="-dynamic-linker" \
+// RUN:         --implicit-check-not='"-shared"' --implicit-check-not='"-pie"'
+
+// CHECK: "-cc1"
+// CHECK-SAME: "-triple" "aarch64-unknown-minixrs"
+// CHECK-SAME: "-resource-dir" "[[RESOURCE_DIR:[^"]+]]"
+// CHECK-SAME: "-internal-externc-isystem" "[[SYSROOT:[^"]+]]{{/|\\\\}}usr{{/|\\\\}}include"
+
+// Static-only: -static is unconditional, and there is no -dynamic-linker.
+// CHECK: {{.*}}ld.lld
+// CHECK-SAME: "--sysroot=[[SYSROOT]]"
+// CHECK-SAME: "-static"
+// The minixrs loader requires page-aligned vaddr *and* file offset per
+// PT_LOAD (minixrs D13).
+// CHECK-SAME: "-z" "max-page-size=4096"
+// CHECK-SAME: "-z" "separate-loadable-segments"
+
+// crt1.o is the C-side brand emitter, so it has to come from the sysroot and
+// not from a host toolchain.
+// CHECK-SAME: "[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}lib{{/|\\\\}}crt1.o"
+// CHECK-SAME: "[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}lib{{/|\\\\}}crti.o"
+// CHECK-SAME: "-L[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}lib"
+// CHECK-SAME: "[[RESOURCE_DIR]]{{/|\\\\}}lib{{/|\\\\}}aarch64-unknown-minixrs{{/|\\\\}}libclang_rt.builtins.a"
+// CHECK-SAME: "-lc"
+// CHECK-SAME: "[[SYSROOT]]{{/|\\\\}}usr{{/|\\\\}}lib{{/|\\\\}}crtn.o"
+
+// Without --sysroot the SDK is located relative to the driver: clang lives in
+// $MINIXRS_SDK/bin and the sysroot in $MINIXRS_SDK/sysroot.
+// RUN: %clang -### %s --target=aarch64-unknown-minixrs 2>&1 \
+// RUN:     | FileCheck --check-prefix=CHECK-DEFAULT-SYSROOT %s
+// CHECK-DEFAULT-SYSROOT: "-L{{[^"]*}}{{/|\\\\}}sysroot{{/|\\\\}}usr{{/|\\\\}}lib"
+
+// The dots must be folded out: check-driver.sh matches the canonical spelling,
+// so a "bin/../sysroot" path would silently miss. This gets its own FileCheck
+// run, with no positive directive, so that its scan region is the whole output.
+// Folded into the run above it would be blind exactly where it matters --
+// "-L{{[^"]*}}/sysroot/usr/lib" also matches the *unfolded* spelling, and a
+// CHECK-NOT never sees text that a positive match consumed. Mutation-tested by
+// deleting the remove_dots call in MinixRS.cpp.
+// The anchor is deliberately the earliest token on the cc1 line: every path
+// that could carry an unfolded spelling comes after it, so the -NOT still
+// covers all of them, and matching "-triple" consumes no path text.
+// RUN: %clang -### %s --target=aarch64-unknown-minixrs 2>&1 \
+// RUN:     | FileCheck --check-prefix=CHECK-NO-DOTS %s
+// CHECK-NO-DOTS: "-triple" "aarch64-unknown-minixrs"
+// CHECK-NO-DOTS-NOT: bin{{/|\\\\}}..
+
+// RUN: %clang -dM -E %s --target=aarch64-unknown-minixrs 2>&1 \
+// RUN:     | FileCheck --check-prefix=CHECK-DEFINES %s
+// CHECK-DEFINES-DAG: #define __minixrs__ 1
+// CHECK-DEFINES-DAG: #define __minixrs 1
+// CHECK-DEFINES-DAG: #define __unix__ 1
+// CHECK-DEFINES-DAG: #define __unix 1
+// CHECK-DEFINES-DAG: #define __ELF__ 1
+// CHECK-DEFINES-DAG: #define __aarch64__ 1
+
+// -shared asks for an output kind the platform does not have. Ignoring it
+// would write a static executable under a .so name, so it is an error.
+// RUN: not %clang -### %s --target=aarch64-unknown-minixrs -shared 2>&1 \
+// RUN:     | FileCheck --check-prefix=CHECK-SHARED %s
+// CHECK-SHARED: error: unsupported option '-shared' for target 'aarch64-unknown-minixrs'
+
+// -pie, -no-pie and -rdynamic name properties minixrs pins rather than a
+// different output kind, so they are accepted, dropped, and not warned about.
+// The positive anchors carry their weight here: a run of bare negatives would
+// also pass on empty output, or on a driver that errored out before it ever
+// emitted a link line.
+// RUN: %clang -### %s --target=aarch64-unknown-minixrs -pie -no-pie -rdynamic 2>&1 \
+// RUN:     | FileCheck --check-prefix=CHECK-CLAIMED %s \
+// RUN:         --implicit-check-not="argument unused during compilation" \
+// RUN:         --implicit-check-not='"-pie"' --implicit-check-not='"-rdynamic"'
+// CHECK-CLAIMED: {{.*}}ld.lld
+// CHECK-CLAIMED-SAME: "-static"
+
+// No sanitizer runtimes are built for this target.
+// RUN: not %clang -### %s --target=aarch64-unknown-minixrs -fsanitize=address 2>&1 \
+// RUN:     | FileCheck --check-prefix=CHECK-NO-SANITIZER %s
+// CHECK-NO-SANITIZER: error: unsupported option '-fsanitize=address' for target 'aarch64-unknown-minixrs'
